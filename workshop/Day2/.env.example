# ===========================================================================
# FinDesk - Day 1 configuration template
# ---------------------------------------------------------------------------
# Copy this file to ".env" and edit the values:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
# Every Python file reads API keys and model names from .env via
# common/config.py - never hardcode them in the code files.
# ===========================================================================

# Provider selection: "ollama" (local, default) or "gemini" (cloud)
LLM_PROVIDER=ollama

# --- Ollama (local) settings ----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Gemini (cloud) settings ----------------------------------------------
# Create your key at https://aistudio.google.com/apikey and paste it below.
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Embedding models (Day 2 - used by RAG in Session 4) -------------------
# Pull the local embedding model once:  ollama pull nomic-embed-text
# Gemini embedding models are part of the free-tier quota.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
GEMINI_EMBEDDING_MODEL=models/embedding-001

# --- Checkpointer (Day 2 - used by Session 5) -----------------------------
# memory : InMemorySaver - conversations lost when the program exits
# sqlite : SqliteSaver   - conversations survive restarts (recommended
#          for the /resume demo)
CHECKPOINTER=sqlite
SQLITE_PATH=findesk.db