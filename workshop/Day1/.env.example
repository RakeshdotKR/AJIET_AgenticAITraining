# ===========================================================================
# FinDesk - Day 1 configuration template
# ---------------------------------------------------------------------------
# Copy this file to ".env" and edit the values:
#     copy .env.example .env      (Windows)
#     cp .env.example .env        (macOS / Linux)
# Every Python file reads API keys and model names from .env via
# common/config.py - never hardcode them in the code files.
# ===========================================================================

# Provider selection: "ollama" (local, default) or "gemini" (cloud)
LLM_PROVIDER=ollama

# --- Ollama (local) settings ----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Gemini (cloud) settings ----------------------------------------------
# Create your key at https://aistudio.google.com/apikey and paste it below.
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
